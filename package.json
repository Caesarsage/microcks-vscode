{
  "name": "microcks-vscode",
  "displayName": "Microcks",
  "description": "Browse Microcks services and tests, import API specs, and run local contract tests from VS Code.",
  "version": "0.1.0",
  "publisher": "microcks",
  "icon": "media/microcks-logo.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/microcks/microcks-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/microcks/microcks-vscode/issues"
  },
  "homepage": "https://microcks.io/",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "keywords": [
    "microcks",
    "api",
    "mocking",
    "contract-testing",
    "openapi"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "microcks",
          "title": "Microcks",
          "icon": "media/microcks-icon.svg"
        }
      ]
    },
    "views": {
      "microcks": [
        {
          "id": "microcksServices",
          "name": "Services",
          "icon": "media/microcks-icon.svg",
          "contextualTitle": "Microcks Services"
        },
        {
          "id": "microcksTests",
          "name": "Tests",
          "contextualTitle": "Microcks Tests"
        }
      ]
    },
    "commands": [
      {
        "command": "microcks.refreshServices",
        "title": "Microcks: Refresh Services",
        "icon": "$(refresh)"
      },
      {
        "command": "microcks.refreshTests",
        "title": "Microcks: Refresh Tests",
        "icon": "$(refresh)"
      },
      {
        "command": "microcks.startLocalServer",
        "title": "Microcks: Start Local Server",
        "icon": "$(run)"
      },
      {
        "command": "microcks.connectRemoteServer",
        "title": "Microcks: Sign In to Remote Server",
        "icon": "$(plug)"
      },
      {
        "command": "microcks.disconnectServer",
        "title": "Microcks: Remove Current Context",
        "icon": "$(trash)"
      },
      {
        "command": "microcks.signOutContext",
        "title": "Microcks: Sign Out of Current Context",
        "icon": "$(sign-out)"
      },
      {
        "command": "microcks.runDryRunForCurrentSpec",
        "title": "Microcks: Run Dry-Run for API File",
        "icon": "$(beaker)"
      },
      {
        "command": "microcks.importCurrentFile",
        "title": "Microcks: Import Current API File",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "microcks.stopDryRunWatch",
        "title": "Microcks: Stop Dry-Run Watch",
        "icon": "$(debug-stop)"
      },
      {
        "command": "microcks.clearDryRunSession",
        "title": "Microcks: Clear Dry-Run Session",
        "icon": "$(clear-all)"
      },
      {
        "command": "microcks.switchContext",
        "title": "Microcks: Switch Context",
        "icon": "$(server)"
      },
      {
        "command": "microcks.filterTests",
        "title": "Microcks: Filter Tests by Service",
        "icon": "$(filter)"
      },
      {
        "command": "microcks.clearTestFilter",
        "title": "Microcks: Clear Test Filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "microcks.setCliPath",
        "title": "Microcks: Set CLI Path",
        "icon": "$(terminal)"
      },
      {
        "command": "microcks.openCliInstallation",
        "title": "Microcks: Install or Update CLI",
        "icon": "$(package)"
      },
      {
        "command": "microcks.openService",
        "title": "Microcks: Open Service in Browser",
        "icon": "$(globe)"
      },
      {
        "command": "microcks.invokeOperation",
        "title": "Microcks: Invoke Mock"
      },
      {
        "command": "microcks.copyMockUrl",
        "title": "Microcks: Copy Mock URL",
        "icon": "$(copy)"
      },
      {
        "command": "microcks.openInspector",
        "title": "Microcks: Open in Inspector",
        "icon": "$(zap)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "microcks.refreshServices",
          "when": "view == microcksServices",
          "group": "navigation"
        },
        {
          "command": "microcks.startLocalServer",
          "when": "view == microcksServices",
          "group": "navigation@2"
        },
        {
          "command": "microcks.switchContext",
          "when": "view == microcksServices",
          "group": "navigation@3"
        },
        {
          "command": "microcks.connectRemoteServer",
          "when": "view == microcksServices",
          "group": "navigation@4"
        },
        {
          "command": "microcks.stopDryRunWatch",
          "when": "view == microcksServices",
          "group": "navigation@5"
        },
        {
          "command": "microcks.importCurrentFile",
          "when": "view == microcksServices",
          "group": "navigation@6"
        },
        {
          "command": "microcks.openCliInstallation",
          "when": "view == microcksServices",
          "group": "navigation@7"
        },
        {
          "command": "microcks.refreshTests",
          "when": "view == microcksTests",
          "group": "navigation@1"
        },
        {
          "command": "microcks.filterTests",
          "when": "view == microcksTests",
          "group": "navigation@2"
        },
        {
          "command": "microcks.switchContext",
          "when": "view == microcksTests",
          "group": "navigation@3"
        },
        {
          "command": "microcks.openCliInstallation",
          "when": "view == microcksTests",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "microcks.openService",
          "when": "view == microcksServices && viewItem == service",
          "group": "inline"
        },
        {
          "command": "microcks.openInspector",
          "when": "view == microcksServices && viewItem == operation",
          "group": "inline@1"
        },
        {
          "command": "microcks.copyMockUrl",
          "when": "view == microcksServices && viewItem == operation",
          "group": "inline@2"
        },
        {
          "command": "microcks.openInspector",
          "when": "view == microcksServices && viewItem == operation",
          "group": "1_actions@1"
        },
        {
          "command": "microcks.copyMockUrl",
          "when": "view == microcksServices && viewItem == operation",
          "group": "1_actions@2"
        }
      ]
    },
    "configuration": {
      "title": "Microcks",
      "properties": {
        "microcks.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to a Microcks CLI executable. If empty, the extension uses its managed CLI when installed, then microcks on PATH."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit",
    "typecheck": "npm run check-types",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:example": "go -C examples/demo-api test ./...",
    "example:demo-api": "go -C examples/demo-api run .",
    "example:demo-api:drift": "go -C examples/demo-api run . -drift",
    "package:vsix": "vsce package --no-dependencies"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "overrides": {
    "diff": "^8.0.3",
    "serialize-javascript": "^7.0.7"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.1",
    "npm-run-all": "^4.1.5",
    "ovsx": "^1.1.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.46.4"
  }
}
